wasi (wasm32-wasip1) portability for jq 1.6.

wasi-libc has no user database (no <pwd.h>, getpwuid or getuid) and no
mktemp()/mkstemp(). jq's own mkstemp() fallback -- which is what pulls in
mktemp() -- is never called from libjq, and get_home() needs the passwd entry
only when $HOME is unset. Compile both out on wasi; every other target is
unaffected.

--- a/src/util.h
+++ b/src/util.h
@@ -13,7 +13,7 @@
 
 #include "jv.h"
 
-#ifndef HAVE_MKSTEMP
+#if !defined(HAVE_MKSTEMP) && !defined(__wasi__)
 int mkstemp(char *template);
 #endif
 
--- a/src/util.c
+++ b/src/util.c
@@ -28,7 +28,7 @@
 void *alloca (size_t);
 # endif
 #endif
-#ifndef WIN32
+#if !defined(WIN32) && !defined(__wasi__)
 #include <pwd.h>
 #endif
 
@@ -58,7 +58,7 @@
 }
 #endif
 
-#ifndef HAVE_MKSTEMP
+#if !defined(HAVE_MKSTEMP) && !defined(__wasi__)
 int mkstemp(char *template) {
   size_t len = strlen(template);
   int tries=5;
@@ -102,7 +102,9 @@
   jv ret;
   char *home = getenv("HOME");
   if (!home) {
-#ifndef WIN32
+#if defined(__wasi__)
+    ret = jv_invalid_with_msg(jv_string("Could not find home directory."));
+#elif !defined(WIN32)
     struct passwd* pwd = getpwuid(getuid());
     if (pwd)
       ret = jv_string(pwd->pw_dir);
